# syntax=docker/dockerfile:1
# Choreo-compatible Dockerfile for Open WebUI
# Uses the official pre-built image from ghcr.io to avoid long build times.
# Only adds a non-root user with UID 10001 to satisfy Choreo's CKV_CHOREO_1 requirement.

FROM ghcr.io/open-webui/open-webui:main

USER root

# Upgrade only the CVE-affected packages (targeted, avoids breaking Python .so extensions)
# CVE-2026-31789: openssl, libssl3, libssl-dev  |  CVE-2026-23112: linux-libc-dev
RUN apt-get update && \
    apt-get install -y --only-upgrade openssl libssl3 libssl-dev linux-libc-dev && \
    rm -rf /var/lib/apt/lists/*

# Create Choreo-compliant non-root user (UID must be 10000-20000)
RUN groupadd --gid 10001 app 2>/dev/null || true && \
    useradd --uid 10001 --gid 10001 --home /home/app --create-home app 2>/dev/null || true && \
    mkdir -p /home/app/.cache/chroma && \
    echo -n 00000000-0000-0000-0000-000000000000 > /home/app/.cache/chroma/telemetry_user_id && \
    mkdir -p /home/app/data && \
    chown -R 10001:10001 /app /home.app

# Copy our patched start script so runtime picks up DATA_DIR defaults and debug logs
COPY backend/start.sh /app/backend/start.sh
RUN chown 10001:10001 /app/backend/start.sh && chmod 0755 /app/backend/start.sh

# open_webui is NOT pip-installed — it's source at /app/backend/open_webui/.
# DATA_DIR is redirected to /home/app/data so UID 10001 can write to it even when
# Choreo mounts a PVC at /app/backend/data (PVC mounts override build-time chown).
WORKDIR /app/backend
ENV HOME=/home/app \
    DATA_DIR=/home/app/data \
    PYTHONPATH=/app/backend

EXPOSE 8080

# Choreo-compliant: literal numeric UID required by CKV_CHOREO_1 (range 10000-20000)
USER 10001

CMD ["bash", "start.sh"]
